{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Outline",
  "description": "outline.json 大纲数据格式，每集一个对象",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "episodeIndex",
      "title",
      "chapterRange",
      "scenes",
      "characters",
      "props",
      "coreConflict",
      "openingHook",
      "outline",
      "keyEvents",
      "emotionalCurve",
      "visualHighlights",
      "endingHook",
      "classicQuotes"
    ],
    "properties": {
      "episodeIndex": {
        "type": "integer",
        "minimum": 1,
        "description": "集数序号"
      },
      "title": {
        "type": "string",
        "description": "标题（含情绪爆点）"
      },
      "chapterRange": {
        "type": "array",
        "items": { "type": "integer" },
        "minItems": 1,
        "description": "对应章节数组"
      },
      "scenes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "minItems": 2,
        "description": "场景数组（>=2个）"
      },
      "characters": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "minItems": 3,
        "description": "角色数组（>=3个）"
      },
      "props": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "description"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "minItems": 3,
        "description": "道具数组（>=3个）"
      },
      "coreConflict": {
        "type": "string",
        "description": "核心矛盾"
      },
      "openingHook": {
        "type": "string",
        "description": "开篇钩子"
      },
      "outline": {
        "type": "string",
        "minLength": 100,
        "maxLength": 900,
        "description": "剧情主干（100-300字，唯一叙事权威）"
      },
      "keyEvents": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 4,
        "maxItems": 4,
        "description": "关键事件（4个：起/承/转/合）"
      },
      "emotionalCurve": {
        "type": "string",
        "description": "情绪曲线"
      },
      "visualHighlights": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 3,
        "maxItems": 5,
        "description": "视觉重点（3-5个）"
      },
      "endingHook": {
        "type": "string",
        "description": "结尾悬念"
      },
      "classicQuotes": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 15
        },
        "minItems": 1,
        "maxItems": 2,
        "description": "金句（1-2句，每句<=15字）"
      }
    }
  }
}
